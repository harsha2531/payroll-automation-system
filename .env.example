# ==============================================================================
# PAYROLL AUTOMATION SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual API keys or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BROWSER-SAFE CONFIGURATION (NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# These variables are exposed to the browser.
# DO NOT place secret keys, passwords, or service-role tokens here!

# Supabase Project URL (from Supabase Dashboard > Project Settings > API)
# Scope: Browser & Server
# Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://nrqhhmkwiwwvorogpzhd.supabase.co

# Supabase Publishable / Anon Key (from Supabase Dashboard > Project Settings > API)
# Scope: Browser & Server
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_5l77GawrskQzfZiokzWnnA_ZRog4Ycj

# Public Application Base URL
# Scope: Browser & Server
# Format: http://localhost:3000 (local) or https://app.yourdomain.com (production)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ------------------------------------------------------------------------------
# 2. SERVER-ONLY CONFIGURATION
# ------------------------------------------------------------------------------
# These variables are accessible ONLY on the server (Node.js runtime / server actions).
# They are never bundled into client-side JavaScript.

# Supabase Service Role Key (from Supabase Dashboard > Project Settings > API)
# WARNING: Bypasses Row Level Security (RLS). Keep strictly confidential!
# Scope: Server Only
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5ycWhobWt3aXd3dm9yb2dwemhkIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MTQ0MzAxMCwiZXhwIjoyMTA3MDE5MDEwfQ.xhNbDJpXmZK4aVIt6DXX8l-jV6YOhSEaC7vFr-vKbRU

# Brevo (Sendinblue) API Key for transactional emails (pay slips, notifications)
# Scope: Server Only
BREVO_API_KEY=your-brevo-api-key

# Brevo Default Transactional Sender Email Address
# Scope: Server Only
# Format: valid email address verified in your Brevo account
BREVO_SENDER_EMAIL=noreply@example.com

# Brevo Default Transactional Sender Display Name
# Scope: Server Only
BREVO_SENDER_NAME="Payroll Automation System"

# Node Execution Environment
# Allowed values: development | production | test
# Scope: Server Only
NODE_ENV=development
